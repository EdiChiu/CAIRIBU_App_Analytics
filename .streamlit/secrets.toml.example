[#] Example secrets file for local development.
# DO NOT COMMIT your real service account JSON. This file is a template only.

# To use locally, create `.streamlit/secrets.toml` (DO NOT commit it) and
# paste your service account JSON as a single TOML string value. Example:
#
# firebase_service_account = '''<PASTE YOUR SERVICE ACCOUNT JSON HERE>'''
#
# Or set the env var `FIREBASE_SERVICE_ACCOUNT` to the JSON string.

# This example intentionally contains NO real JSON or private keys.
